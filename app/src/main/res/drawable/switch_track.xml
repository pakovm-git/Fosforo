<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_checked="true"><shape>
    <size android:width="48dp" android:height="28dp"/>
    <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"/>
    <solid android:color="@color/bfi_selected"/><corners android:radius="6dp"/>
    <stroke android:width="2dp" android:color="@color/bfi_selected_outline"/>
  </shape></item>
  <item><shape>
    <size android:width="48dp" android:height="28dp"/>
    <padding android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp"/>
    <solid android:color="@color/bfi_surface_secondary"/><corners android:radius="6dp"/>
    <stroke android:width="2dp" android:color="@color/bfi_outline"/>
  </shape></item>
</selector>
