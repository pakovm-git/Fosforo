<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetTop="10dp" android:insetBottom="10dp">
<selector>
  <item android:state_enabled="false">
    <shape>
      <solid android:color="@color/bfi_surface_secondary" />
      <corners android:radius="12dp" />
      <stroke android:width="2dp" android:color="@color/bfi_outline" />
    </shape>
  </item>
  <item android:state_focused="true">
    <shape>
      <solid android:color="@color/bfi_surface_secondary" />
      <corners android:radius="12dp" />
      <stroke android:width="3dp" android:color="@color/bfi_focus" />
    </shape>
  </item>
  <item android:state_pressed="true">
    <shape>
      <solid android:color="@color/bfi_pressed" />
      <corners android:radius="12dp" />
      <stroke android:width="2dp" android:color="@color/bfi_focus" />
    </shape>
  </item>
  <item>
    <shape>
      <solid android:color="@color/bfi_surface_secondary" />
      <corners android:radius="12dp" />
      <stroke android:width="2dp" android:color="@color/bfi_outline" />
    </shape>
  </item>
</selector>

</inset>