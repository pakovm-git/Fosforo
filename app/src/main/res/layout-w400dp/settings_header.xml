<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:background="@drawable/group_header" android:tag="glass-bar" android:paddingHorizontal="16dp" android:paddingVertical="10dp">
  <Button android:id="@+id/back_action" style="@style/HeaderAction" android:layout_width="wrap_content" android:text="@string/back_with_arrow" />
  <TextView android:id="@+id/screen_title" style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="0dp" android:textSize="@dimen/settings_title_size" android:minHeight="48dp" android:maxLines="2" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" />
  <Button android:id="@+id/editing_stop" style="@style/HeaderStopAction" android:layout_width="wrap_content" android:layout_marginEnd="8dp" android:text="@string/stop" android:contentDescription="@string/turn_off" android:visibility="gone" />
  <Button android:id="@+id/restore_action" style="@style/HeaderAction" android:layout_width="wrap_content" android:maxWidth="@dimen/restore_button_width" android:text="@string/restore_defaults" />
</LinearLayout>
