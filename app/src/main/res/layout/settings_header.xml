<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
    <Button android:id="@+id/back_action" style="@style/HeaderAction" android:layout_width="wrap_content" android:text="@string/back" />
    <TextView android:id="@+id/screen_title" style="@style/SectionTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="0dp" android:textSize="@dimen/settings_title_size" android:minHeight="48dp" android:maxLines="2" android:ellipsize="end" android:gravity="center_vertical" android:includeFontPadding="false" />
    <Button android:id="@+id/restore_action" style="@style/HeaderAction" android:layout_width="wrap_content" android:maxWidth="@dimen/restore_button_width" android:text="@string/restore_defaults" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end|center_vertical" android:baselineAligned="false">
    <Button android:id="@+id/advanced_action" style="@style/HeaderAction" android:layout_width="wrap_content" android:layout_marginEnd="8dp" android:text="@string/advanced_title" android:visibility="gone" />
    <Button android:id="@+id/editing_stop" style="@style/HeaderStopAction" android:layout_width="wrap_content" android:text="@string/stop" android:contentDescription="@string/turn_off" android:visibility="gone" />
  </LinearLayout>
</LinearLayout>
