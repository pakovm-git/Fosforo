<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:tag="glass" android:clipToOutline="true" android:padding="2dp">
<TextView style="@style/GroupTitle" android:text="@string/home_effects_heading" android:textAllCaps="true" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:background="@drawable/group_card_header" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
<Switch android:id="@+id/crt_switch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/crt_shader_short" android:saveEnabled="false" />
<Button android:id="@+id/crt_action" style="@style/PreferenceAction" android:text="@string/configure_crt" />
<View android:layout_width="match_parent" android:layout_height="2dp" android:background="@color/bfi_outline" android:layout_marginVertical="8dp" />
<Switch android:id="@+id/bfi_switch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/bfi_effect_long" android:saveEnabled="false" />
<Button android:id="@+id/pattern_action" style="@style/PreferenceAction" android:text="@string/configure_bfi" />
</LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:tag="glass" android:clipToOutline="true" android:padding="2dp" android:layout_marginTop="12dp">
<TextView style="@style/GroupTitle" android:text="@string/home_scope_heading" android:textAllCaps="true" android:paddingHorizontal="10dp" android:paddingVertical="6dp" android:background="@drawable/group_card_header" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
<RadioGroup android:id="@+id/home_scope" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:background="@drawable/segment_track" android:padding="0dp" android:paddingHorizontal="2dp">
<RadioButton android:id="@+id/home_scope_system" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/system_wide" android:saveEnabled="false" />
<RadioButton android:id="@+id/home_scope_apps" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/home_scope_apps" android:saveEnabled="false" />
</RadioGroup>
<Button android:id="@+id/apps_action" style="@style/PreferenceAction" android:text="@string/configure_apps" android:layout_marginTop="8dp" />
</LinearLayout></LinearLayout><TextView android:id="@+id/input_notice" style="@style/Secondary" android:visibility="gone" /></LinearLayout>
