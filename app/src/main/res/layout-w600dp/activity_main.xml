<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
  <LinearLayout android:id="@+id/home_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="8dp" android:layout_marginBottom="12dp" android:baselineAligned="false">
    <ImageView android:id="@+id/home_logo" android:layout_width="126.4dp" android:layout_height="40dp" android:src="@drawable/bfi_logo" android:contentDescription="@string/app_name" android:scaleType="fitCenter" />
    <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
  <CheckBox android:id="@+id/resume_unlock_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/resume_unlock" android:textSize="16sp" android:textColor="@color/bfi_text_primary" android:buttonTint="@color/bfi_action" android:saveEnabled="false" android:maxWidth="280dp" android:layout_marginStart="8dp" />
  </LinearLayout>
  <LinearLayout android:id="@+id/home_panels_wide" android:orientation="horizontal" android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/home_header">
    <ScrollView android:id="@+id/status_scroll_wide" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.36" android:layout_marginEnd="12dp" android:background="@drawable/card" android:padding="16dp" android:fillViewport="true" android:scrollbarStyle="outsideInset">
      <include layout="@layout/home_status" />
    </ScrollView>
    <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.64" android:background="@drawable/card" android:padding="16dp">
      <TextView android:id="@+id/choose_heading_wide" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_action" android:textSize="20sp" android:textColor="@color/bfi_text_primary" android:layout_marginBottom="8dp" />
      <Button android:id="@+id/main_action" style="@style/PrimaryAction" android:layout_below="@id/choose_heading_wide" android:text="@string/start_effects" android:layout_marginBottom="10dp" />
      <ScrollView android:id="@+id/actions_scroll_wide" android:layout_below="@id/main_action" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbarStyle="outsideInset">
        <include layout="@layout/home_actions" />
      </ScrollView>
    </RelativeLayout>
  </LinearLayout>
</RelativeLayout>
