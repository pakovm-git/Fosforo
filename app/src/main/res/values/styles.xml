<resources>
  <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/bfi_focus</item>
    <item name="android:colorControlNormal">@color/bfi_text_secondary</item>
    <item name="android:colorControlActivated">@color/bfi_focus</item>
    <item name="android:windowBackground">@color/bfi_page</item>
    <item name="android:colorBackground">@color/bfi_page</item>
    <item name="android:textColorPrimary">@color/bfi_text_primary</item>
    <item name="android:textColorSecondary">@color/bfi_text_secondary</item>
    <item name="android:statusBarColor">@color/bfi_page</item>
    <item name="android:navigationBarColor">@color/bfi_legacy_navigation</item>
    <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowSoftInputMode">adjustResize|stateHidden</item>
    <item name="android:colorBackgroundFloating">@color/bfi_surface</item>
  </style>
  <style name="AppTheme" parent="AppThemeBase" />
  <style name="Body">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">@color/bfi_text_primary</item>
    <item name="android:lineSpacingExtra">2dp</item>
  </style>
  <style name="Secondary" parent="Body">
    <item name="android:textSize">14sp</item>
    <item name="android:textColor">@color/bfi_text_secondary</item>
  </style>
  <style name="SectionTitle" parent="Body">
    <item name="android:textSize">20sp</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:layout_marginBottom">8dp</item>
  </style>
  <style name="Action" parent="android:style/Widget.Material.Button">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">48dp</item>
    <item name="android:paddingStart">12dp</item>
    <item name="android:paddingEnd">12dp</item>
    <item name="android:paddingTop">8dp</item>
    <item name="android:paddingBottom">8dp</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:background">@drawable/secondary_action</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:textColor">@color/secondary_action_text</item>
    <item name="android:stateListAnimator">@null</item>
  </style>
  <style name="PrimaryAction" parent="Action">
    <item name="android:background">@drawable/primary_action</item>
    <item name="android:textColor">@color/primary_action_text</item>
  </style>
  <style name="HeaderAction" parent="Action">
    <item name="android:minWidth">0dp</item>
    <item name="android:textSize">14sp</item>
    <item name="android:paddingStart">8dp</item>
    <item name="android:paddingEnd">8dp</item>
  </style>
  <style name="HeaderStopAction" parent="HeaderAction">
    <item name="android:minWidth">48dp</item>
    <item name="android:background">@drawable/stop_action</item>
    <item name="android:textColor">@color/stop_action_text</item>
  </style>
  <style name="TileMenuTheme" parent="AppTheme">
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowCloseOnTouchOutside">true</item>
    <item name="android:backgroundDimEnabled">true</item>
    <item name="android:windowBackground">@drawable/card</item>
  </style>
</resources>
