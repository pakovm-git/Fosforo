# BFI configuration: accumulation, horizontal/vertical blur, then CRT composition.
shaders=4
shader0=shaders/newpixie/accumulate.slang
alias0=accum1
scale_type0=source
scale0=1.0
filter_linear0=true
shader1=shaders/newpixie/blur_horiz.slang
alias1=blur1
scale_type1=source
scale1=1.0
filter_linear1=true
shader2=shaders/newpixie/blur_vert.slang
alias2=blur2
scale_type2=source
scale2=1.0
filter_linear2=true
shader3=shaders/newpixie/newpixie-crt.slang
scale_type3=viewport
filter_linear3=true
textures=frametexture
frametexture=shaders/newpixie/crtframe.png
frametexture_linear=true
frametexture_wrap_mode=clamp_to_border
